// Tenant database — one per tenant.
//
// Source of truth: docs/db/Orvidex — TENANT DB (one per tenant).png.
// Separate from prisma/schema.prisma on purpose: that models the master
// database, this models what every tenant gets its own copy of. They are
// different databases with different lifecycles, so they get different
// clients — a single client typed against both would let a query for a
// tenant's products run against the master connection, which is the one
// mistake this architecture exists to prevent.
//
// The provisioning SQL in src/server/tenancy/schema/ is generated from this
// file (see `npm run tenant:sql`), so the schema is defined once.
//
// Decisions the ERD does not express, marked inline:
//   [T-01] Enum members. Most enum columns are drawn simply as `enum`.
//   [T-02] `timestamptz(3)` for the ERD's `timestamptz`; tenants span zones.
//   [T-03] Explicit decimal precision, which Postgres requires for money.
//   [T-04] `users` and `user_sessions` are NOT on this ERD. It marks every
//          staff reference "(master ref)", which would put tenant staff in
//          the master `tenant_users` table. They are kept here at the product
//          owner's direction: tenant sign-in authenticates against this
//          database today, and moving it is a separate piece of work. The
//          RBAC tables that used to sit beside them (roles, permissions,
//          user_roles, role_permissions) are gone — no code ever read them.
//   [T-05] Embeddings. The ERD draws `vector(1536)`, which needs the pgvector
//          extension. It is not available on this deployment's PostgreSQL
//          (`CREATE EXTENSION vector` fails: not available), so the columns
//          are `Bytes` for now. Swapping them to a real vector type is one
//          migration, but re-embedding a populated catalogue costs API money,
//          so install pgvector before any embeddings are written.
//
// Columns marked INFERRED are hidden behind an overlapping box in the source
// diagram. Only their types are readable, and for `orders` not even that.
// Their names are a proposal awaiting confirmation.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
  // Never read at runtime: tenant clients are constructed with an explicit
  // adapter per tenant. Present because Prisma requires a datasource.
  url      = env("TENANT_SCHEMA_DATABASE_URL")
}

// ---------------------------------------------------------------- enums [T-01]

/// [T-04] Kept for tenant sign-in; not on the ERD.
enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum CustomerSource {
  WHATSAPP
  WEB
  MANUAL

  @@map("customer_source")
}

/// INFERRED members. The ERD draws only `enum`.
enum CustomerStatus {
  ACTIVE
  BLOCKED
  OPTED_OUT

  @@map("customer_status")
}

/// INFERRED members. The ERD draws `enum browsing..confirmed`, so these are
/// the endpoints of a funnel with the middle left to us.
enum ConversationState {
  BROWSING
  COLLECTING
  CONFIRMING
  CONFIRMED

  @@map("conversation_state")
}

enum ConversationStatus {
  OPEN
  CLOSED

  @@map("conversation_status")
}

enum MessageDirection {
  IN
  OUT

  @@map("message_direction")
}

enum MessageSenderType {
  CUSTOMER
  AI
  AGENT

  @@map("message_sender_type")
}

enum MessageType {
  TEXT
  IMAGE
  INTERACTIVE
  TEMPLATE

  @@map("message_type")
}

/// INFERRED members. The ERD draws only `enum`.
enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum CartStatus {
  ACTIVE
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum OrderSource {
  WHATSAPP
  WEB
  MANUAL

  @@map("order_source")
}

/// INFERRED members. The ERD draws only `enum`.
enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

/// INFERRED members. The ERD draws only `enum`. Separate from `PaymentStatus`
/// below: this is the order's overall stance, that one is a single attempt.
enum OrderPaymentStatus {
  UNPAID
  PARTIAL
  PAID
  REFUNDED

  @@map("order_payment_status")
}

enum OrderEventActorType {
  AI
  AGENT
  SYSTEM

  @@map("order_event_actor_type")
}

/// INFERRED members. The ERD draws only `enum`.
enum PaymentStatus {
  PENDING
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum KnowledgeSourceType {
  FAQ
  POLICY
  FILE
  URL

  @@map("knowledge_source_type")
}

enum KnowledgeStatus {
  PENDING
  INDEXED
  FAILED

  @@map("knowledge_status")
}

/// INFERRED members. The ERD draws only `enum`.
enum AiUsageStatus {
  SUCCESS
  ERROR
  THROTTLED

  @@map("ai_usage_status")
}

// ------------------------------------------------- tenant staff [T-04]

/// Not on the ERD. Tenant sign-in resolves against this table, so it stays
/// until authentication moves to the master `tenant_users`.
model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(190)
  passwordHash String     @map("password_hash")
  name         String     @db.VarChar(120)
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  sessions UserSession[]

  @@index([status])
  @@map("users")
}

/// Revocable sessions for tenant staff. Not on the ERD; see [T-04].
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address") @db.VarChar(100)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

// --------------------------------------------------------------- customers

/// One row per person the business deals with.
///
/// `wa_id` is the WhatsApp identity and is unique, so the worker can route an
/// inbound message to a customer without a second lookup table. The separate
/// `contacts` table the previous schema carried is gone: it existed only to
/// hold this column.
model Customer {
  id          String         @id @default(uuid()) @db.Uuid
  waId        String         @unique @map("wa_id") @db.VarChar(40)
  phone       String         @db.VarChar(30)
  name        String?        @db.VarChar(150)
  profileName String?        @map("profile_name") @db.VarChar(150)
  email       String?        @db.VarChar(190)
  source      CustomerSource @default(WHATSAPP)
  status      CustomerStatus @default(ACTIVE)
  firstSeenAt DateTime       @default(now()) @map("first_seen_at") @db.Timestamptz(3)
  lastSeenAt  DateTime       @default(now()) @map("last_seen_at") @db.Timestamptz(3)

  addresses     Address[]
  conversations Conversation[]
  carts         Cart[]
  orders        Order[]

  @@index([phone])
  @@index([lastSeenAt])
  @@map("customers")
}

model Address {
  id             String  @id @default(uuid()) @db.Uuid
  customerId     String  @map("customer_id") @db.Uuid
  deliveryZoneId String? @map("delivery_zone_id") @db.Uuid
  label          String? @db.VarChar(50)
  recipientName  String  @map("recipient_name") @db.VarChar(150)
  phone          String  @db.VarChar(30)
  addressLine    String  @map("address_line")
  city           String  @db.VarChar(100)
  region         String? @db.VarChar(100)
  isDefault      Boolean @default(false) @map("is_default")

  customer      Customer      @relation(fields: [customerId], references: [id], onDelete: Cascade)
  deliveryZone  DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)
  shippedOrders Order[]

  @@index([customerId])
  @@map("addresses")
}

/// Where the business delivers, and what it charges to get there.
///
/// `area_keywords` is a text array rather than a join table because the AI
/// agent matches a free-text address against it; there is nothing to join to.
model DeliveryZone {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(120)
  areaKeywords String[] @map("area_keywords")
  charge       Decimal  @db.Decimal(12, 2)
  freeAbove    Decimal? @map("free_above") @db.Decimal(12, 2)
  etaDays      Int      @map("eta_days")
  isActive     Boolean  @default(true) @map("is_active")

  addresses Address[]
  orders    Order[]

  @@map("delivery_zones")
}

// --------------------------------------------------------------- catalogue

model Category {
  id       String  @id @default(uuid()) @db.Uuid
  /// Self-referencing tree. SetNull, not Cascade: removing a parent promotes
  /// its children rather than deleting a whole branch.
  parentId String? @map("parent_id") @db.Uuid
  name     String  @db.VarChar(150)
  slug     String  @unique @db.VarChar(180)
  isActive Boolean @default(true) @map("is_active")

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id          String        @id @default(uuid()) @db.Uuid
  categoryId  String?       @map("category_id") @db.Uuid
  name        String        @db.VarChar(220)
  slug        String        @unique @db.VarChar(220)
  description String?
  basePrice   Decimal       @map("base_price") @db.Decimal(12, 2)
  /// Free-form product attributes, and where images and tags live: the ERD
  /// models no separate table for either.
  attributes  Json?
  status      ProductStatus @default(DRAFT)
  /// Soft delete. A product on an order line must never actually be removed.
  deletedAt   DateTime?     @map("deleted_at") @db.Timestamptz(3)

  category   Category?          @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants   ProductVariant[]
  embeddings ProductEmbedding[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique @db.VarChar(100)
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  attributes     Json?
  isActive       Boolean  @default(true) @map("is_active")

  product      Product                @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory    Inventory?
  cartItems    CartItem[]
  orderItems   OrderItem[]
  reservations InventoryReservation[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String @id @default(uuid()) @db.Uuid
  productVariantId String @unique @map("product_variant_id") @db.Uuid
  quantity         Int    @default(0)
  reservedQuantity Int    @default(0) @map("reserved_quantity")
  reorderLevel     Int?   @map("reorder_level")

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

/// Stock held for a cart that has not checked out yet.
///
/// Expiry is a column rather than a job: a reservation is only honoured while
/// `expires_at` is in the future, so a worker that never runs cannot strand
/// stock forever.
model InventoryReservation {
  id               String   @id @default(uuid()) @db.Uuid
  cartId           String   @map("cart_id") @db.Uuid
  productVariantId String   @map("product_variant_id") @db.Uuid
  quantity         Int
  expiresAt        DateTime @map("expires_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@index([cartId])
  @@index([expiresAt])
  @@map("inventory_reservations")
}

/// A chunk of product text and its embedding, for semantic retrieval.
///
/// [T-05] `embedding` is drawn as `vector(1536)` and stored as bytes until
/// pgvector is available. Nothing can search it in this form.
model ProductEmbedding {
  id        String   @id @default(uuid()) @db.Uuid
  productId String   @map("product_id") @db.Uuid
  chunkText String   @map("chunk_text")
  embedding Bytes
  model     String   @db.VarChar(80)
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  product Product @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@index([productId])
  @@map("product_embeddings")
}

// ------------------------------------------------------------------- carts

model Cart {
  id             String     @id @default(uuid()) @db.Uuid
  /// Nullable: someone browsing on WhatsApp has no customer record yet.
  customerId     String?    @map("customer_id") @db.Uuid
  conversationId String?    @map("conversation_id") @db.Uuid
  status         CartStatus @default(ACTIVE)
  expiresAt      DateTime?  @map("expires_at") @db.Timestamptz(3)
  updatedAt      DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer     Customer?              @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation Conversation?          @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  items        CartItem[]
  reservations InventoryReservation[]

  @@index([customerId])
  @@index([status])
  @@map("carts")
}

model CartItem {
  id                 String  @id @default(uuid()) @db.Uuid
  cartId             String  @map("cart_id") @db.Uuid
  productVariantId   String  @map("product_variant_id") @db.Uuid
  quantity           Int
  /// Snapshot, so a price change mid-conversation does not silently alter
  /// what the customer was quoted.
  unitPriceSnapshot  Decimal @map("unit_price_snapshot") @db.Decimal(12, 2)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@map("cart_items")
}

// ------------------------------------------------------------------ orders

model Order {
  id                String             @id @default(uuid()) @db.Uuid
  customerId        String?            @map("customer_id") @db.Uuid
  conversationId    String?            @map("conversation_id") @db.Uuid
  shippingAddressId String?            @map("shipping_address_id") @db.Uuid
  deliveryZoneId    String?            @map("delivery_zone_id") @db.Uuid
  orderNumber       String             @unique @map("order_number") @db.VarChar(80)
  source            OrderSource        @default(WHATSAPP)
  status            OrderStatus        @default(PENDING)
  paymentStatus     OrderPaymentStatus @default(UNPAID) @map("payment_status")
  subtotal          Decimal            @db.Decimal(12, 2)
  /// INFERRED, with the four fields below it. These five are drawn underneath
  /// the `ai_usage_logs` box in the diagram and neither their names nor their
  /// types are readable. The shape is taken from what the order screens and
  /// the delivery-zone charge require.
  discount          Decimal            @default(0) @db.Decimal(12, 2)
  deliveryCharge    Decimal            @default(0) @map("delivery_charge") @db.Decimal(12, 2)
  total             Decimal            @db.Decimal(12, 2)
  placedAt          DateTime           @default(now()) @map("placed_at") @db.Timestamptz(3)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        Customer?     @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversation    Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)
  shippingAddress Address?      @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  deliveryZone    DeliveryZone? @relation(fields: [deliveryZoneId], references: [id], onDelete: SetNull)

  items    OrderItem[]
  events   OrderEvent[]
  payments OrderPayment[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productVariantId    String  @map("product_variant_id") @db.Uuid
  /// Snapshots keep the line readable after a rename, and are why the variant
  /// relation can be Restrict without blocking catalogue tidy-ups forever.
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(220)
  skuSnapshot         String  @map("sku_snapshot") @db.VarChar(100)
  unitPrice           Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity            Int
  total               Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

/// The audit trail for one order's status.
///
/// `actor_id` points at a master `tenant_users` row and is a bare uuid,
/// because Postgres cannot express a cross-database foreign key.
model OrderEvent {
  id         BigInt              @id @default(autoincrement())
  orderId    String              @map("order_id") @db.Uuid
  fromStatus String?             @map("from_status") @db.VarChar(40)
  toStatus   String              @map("to_status") @db.VarChar(40)
  actorType  OrderEventActorType @map("actor_type")
  actorId    String?             @map("actor_id") @db.Uuid
  note       String?
  createdAt  DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId, createdAt])
  @@map("order_events")
}

model OrderPayment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  /// bkash, nagad or cod in this market; free text so a new one needs no
  /// migration.
  provider          String        @db.VarChar(80)
  providerReference String?       @map("provider_reference") @db.VarChar(190)
  /// Unique: a retried payment callback must not charge or credit twice.
  idempotencyKey    String        @unique @map("idempotency_key") @db.VarChar(128)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.Char(3)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payments")
}

// ----------------------------------------------------------- conversations

/// One WhatsApp thread.
///
/// `whatsapp_account_id` and `assigned_user_id` both point into the master
/// database — the account registry and the staff list live there — so they are
/// bare uuids with no foreign key.
model Conversation {
  id                String             @id @default(uuid()) @db.Uuid
  customerId        String             @map("customer_id") @db.Uuid
  whatsappAccountId String             @map("whatsapp_account_id") @db.Uuid
  assignedUserId    String?            @map("assigned_user_id") @db.Uuid
  state             ConversationState  @default(BROWSING)
  /// True while a human has taken over, so the worker must not reply.
  aiPaused          Boolean            @default(false) @map("ai_paused")
  /// When the 24-hour WhatsApp service window closes. After it, only an
  /// approved template may be sent.
  windowExpiresAt   DateTime?          @map("window_expires_at") @db.Timestamptz(3)
  lastMessageAt     DateTime?          @map("last_message_at") @db.Timestamptz(3)
  status            ConversationStatus @default(OPEN)

  customer    Customer     @relation(fields: [customerId], references: [id], onDelete: Cascade)
  messages    Message[]
  escalations Escalation[]
  carts       Cart[]
  orders      Order[]
  aiUsageLogs AiUsageLog[]

  @@index([customerId])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                 String            @id @default(uuid()) @db.Uuid
  conversationId     String            @map("conversation_id") @db.Uuid
  /// Unique: the provider retries, and a retry must not be stored twice.
  providerMessageId  String?           @unique @map("provider_message_id") @db.VarChar(190)
  direction          MessageDirection
  senderType         MessageSenderType @map("sender_type")
  messageType        MessageType       @default(TEXT) @map("message_type")
  content            String?
  mediaUrl           String?           @map("media_url")
  interactivePayload Json?             @map("interactive_payload")
  replyToMessageId   String?           @map("reply_to_message_id") @db.Uuid
  /// INFERRED, with the three fields below it. These four sit underneath the
  /// `inventory` box in the diagram; only their types are readable — one
  /// ending in ")", then three nullable timestamps. Delivery receipts are what
  /// fits that shape.
  errorCode          String?           @map("error_code") @db.VarChar(80)
  sentAt             DateTime?         @map("sent_at") @db.Timestamptz(3)
  deliveredAt        DateTime?         @map("delivered_at") @db.Timestamptz(3)
  readAt             DateTime?         @map("read_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId, sentAt])
  @@map("messages")
}

/// A conversation handed to a person.
///
/// `resolved_by_user_id` points at a master `tenant_users` row, so it is a
/// bare uuid with no foreign key.
model Escalation {
  id                String    @id @default(uuid()) @db.Uuid
  conversationId    String    @map("conversation_id") @db.Uuid
  reason            String    @db.VarChar(80)
  resolvedByUserId  String?   @map("resolved_by_user_id") @db.Uuid
  resolvedAt        DateTime? @map("resolved_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)

  @@index([conversationId])
  @@map("escalations")
}

// ------------------------------------------------------------- ai and store

/// A document the AI agent may quote from — an FAQ, a policy, an upload.
model KnowledgeDocument {
  id         String              @id @default(uuid()) @db.Uuid
  title      String              @db.VarChar(220)
  sourceType KnowledgeSourceType @map("source_type")
  rawContent String?             @map("raw_content")
  status     KnowledgeStatus     @default(PENDING)

  chunks KnowledgeChunk[]

  @@index([status])
  @@map("knowledge_documents")
}

/// [T-05] `embedding` is drawn as `vector(1536)`; see the note at the top.
model KnowledgeChunk {
  id         String @id @default(uuid()) @db.Uuid
  documentId String @map("document_id") @db.Uuid
  chunkText  String @map("chunk_text")
  embedding  Bytes

  document KnowledgeDocument @relation(fields: [documentId], references: [id], onDelete: Cascade)

  @@index([documentId])
  @@map("knowledge_chunks")
}

/// One row per AI call.
///
/// `model_id` references the master `ai_models` table, so it is a bare uuid.
model AiUsageLog {
  id             BigInt        @id @default(autoincrement())
  conversationId String?       @map("conversation_id") @db.Uuid
  modelId        String        @map("model_id") @db.Uuid
  requestType    String        @map("request_type") @db.VarChar(80)
  inputTokens    BigInt        @default(0) @map("input_tokens")
  outputTokens   BigInt        @default(0) @map("output_tokens")
  estimatedCost  Decimal       @default(0) @map("estimated_cost") @db.Decimal(12, 4)
  status         AiUsageStatus @default(SUCCESS)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([conversationId])
  @@map("ai_usage_logs")
}

/// How the AI agent presents itself. One row per tenant in practice.
model AgentSetting {
  id              String   @id @default(uuid()) @db.Uuid
  persona         String
  tone            String   @db.VarChar(40)
  languages       String[]
  greeting        String?
  businessHours   Json?    @map("business_hours")
  paymentMethods  Json     @map("payment_methods")
  returnPolicy    String?  @map("return_policy")
  escalationRules Json?    @map("escalation_rules")
  isActive        Boolean  @default(true) @map("is_active")

  @@map("agent_settings")
}

/// Key and value configuration. The key is the primary key: the ERD draws no
/// surrogate id, and there is nothing a second column would add.
model StoreSetting {
  settingKey String   @id @map("setting_key") @db.VarChar(120)
  value      Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}
