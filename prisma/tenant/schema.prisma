// Tenant database — one per tenant.
//
// Source of truth: docs/db/Orvidex — TENANT DB (one per tenant).png.
// Separate from prisma/schema.prisma on purpose: that models the
// master database, this models what every tenant gets its own copy of. They
// are different databases with different lifecycles, so they get different
// clients — a single client typed against both would let a query for a tenant's
// products run against the master connection, which is the one mistake this
// architecture exists to prevent.
//
// The provisioning SQL in src/server/tenancy/schema/ is generated from this
// file (see `npm run tenant:sql`), so the schema is defined once.
//
// Decisions the ERD does not express, marked inline:
//   [T-01] Enum members. Every enum column is drawn simply as `enum`.
//   [T-02] `timestamptz` for the ERD's `timestamp`; tenants span time zones.
//   [T-03] Explicit decimal precision, which Postgres requires for money.
//   [T-04] `user_sessions` is not on the ERD. Tenant users need somewhere to
//          hold a revocable session, and the master database must not hold one
//          tenant's sessions.

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["driverAdapters"]
  output          = "../../src/generated/tenant"
}

datasource db {
  provider = "postgresql"
  // Never read at runtime: tenant clients are constructed with an explicit
  // adapter per tenant. Present because Prisma requires a datasource.
  url      = env("TENANT_SCHEMA_DATABASE_URL")
}

// ---------------------------------------------------------------- enums [T-01]

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED

  @@map("user_status")
}

enum CustomerStatus {
  ACTIVE
  BLOCKED

  @@map("customer_status")
}

enum ProductStatus {
  DRAFT
  ACTIVE
  ARCHIVED

  @@map("product_status")
}

enum CartStatus {
  OPEN
  CONVERTED
  ABANDONED

  @@map("cart_status")
}

enum OrderStatus {
  PENDING
  CONFIRMED
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
  REFUNDED

  @@map("order_status")
}

enum PaymentStatus {
  PENDING
  AUTHORIZED
  PAID
  FAILED
  REFUNDED

  @@map("payment_status")
}

enum ReviewStatus {
  PENDING
  PUBLISHED
  REJECTED

  @@map("review_status")
}

enum WhatsappAccountStatus {
  CONNECTED
  AUTH_REQUIRED
  DISCONNECTED

  @@map("whatsapp_account_status")
}

enum WhatsappVerificationStatus {
  PENDING
  VERIFIED
  REJECTED

  @@map("whatsapp_verification_status")
}

enum ContactStatus {
  ACTIVE
  BLOCKED
  OPTED_OUT

  @@map("contact_status")
}

enum ConversationStatus {
  OPEN
  PENDING
  RESOLVED
  CLOSED

  @@map("conversation_status")
}

enum MessageDirection {
  INBOUND
  OUTBOUND

  @@map("message_direction")
}

enum MessageSenderType {
  CUSTOMER
  AGENT
  AI
  SYSTEM

  @@map("message_sender_type")
}

enum MessageType {
  TEXT
  IMAGE
  AUDIO
  VIDEO
  DOCUMENT
  LOCATION
  TEMPLATE

  @@map("message_type")
}

enum MessageStatus {
  QUEUED
  SENT
  DELIVERED
  READ
  FAILED

  @@map("message_status")
}

enum WebhookEventStatus {
  RECEIVED
  PROCESSED
  FAILED

  @@map("webhook_event_status")
}

enum AiUsageStatus {
  SUCCESS
  ERROR
  THROTTLED

  @@map("ai_usage_status")
}

// -------------------------------------------------- tenant staff and access

model User {
  id           String     @id @default(uuid()) @db.Uuid
  email        String     @unique @db.VarChar(190)
  passwordHash String     @map("password_hash")
  name         String     @db.VarChar(120)
  /// URL into the avatar upload base, never file bytes. Mirrors
  /// `admin_users.avatar_url` in the master database.
  avatarUrl    String?    @map("avatar_url")
  status       UserStatus @default(INVITED)
  lastLoginAt  DateTime?  @map("last_login_at") @db.Timestamptz(3)
  createdAt    DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  roles         UserRole[]
  sessions      UserSession[]
  conversations Conversation[]

  @@index([status])
  @@map("users")
}

/// Revocable sessions for tenant staff [T-04].
///
/// Mirrors the master database's `admin_sessions`: the cookie carries an
/// opaque token and only its SHA-256 hash is stored, so a stolen database
/// row cannot be replayed as a session. Signing a stateless token instead
/// would make sign-out and suspension unenforceable until expiry.
model UserSession {
  id        String    @id @default(uuid()) @db.Uuid
  userId    String    @map("user_id") @db.Uuid
  tokenHash String    @unique @map("token_hash")
  expiresAt DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt DateTime? @map("revoked_at") @db.Timestamptz(3)
  ipAddress String?   @map("ip_address") @db.VarChar(100)
  userAgent String?   @map("user_agent")
  createdAt DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([expiresAt])
  @@map("user_sessions")
}

model Role {
  id          String   @id @default(uuid()) @db.Uuid
  name        String   @unique @db.VarChar(80)
  description String?
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  users       UserRole[]
  permissions RolePermission[]

  @@map("roles")
}

model UserRole {
  userId String @map("user_id") @db.Uuid
  roleId String @map("role_id") @db.Uuid

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  role Role @relation(fields: [roleId], references: [id], onDelete: Cascade)

  @@id([userId, roleId])
  @@map("user_roles")
}

model Permission {
  id          String  @id @default(uuid()) @db.Uuid
  code        String  @unique @db.VarChar(120)
  description String?

  roles RolePermission[]

  @@map("permissions")
}

model RolePermission {
  roleId       String @map("role_id") @db.Uuid
  permissionId String @map("permission_id") @db.Uuid

  role       Role       @relation(fields: [roleId], references: [id], onDelete: Cascade)
  permission Permission @relation(fields: [permissionId], references: [id], onDelete: Cascade)

  @@id([roleId, permissionId])
  @@map("role_permissions")
}

// ----------------------------------------------------- customers and places

model Customer {
  id        String         @id @default(uuid()) @db.Uuid
  email     String?        @db.VarChar(190)
  name      String         @db.VarChar(150)
  phone     String?        @db.VarChar(30)
  status    CustomerStatus @default(ACTIVE)
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(3)

  addresses Address[]
  carts     Cart[]
  orders    Order[]
  reviews   Review[]
  contacts  Contact[]

  @@index([phone])
  @@index([email])
  @@map("customers")
}

model Address {
  id            String  @id @default(uuid()) @db.Uuid
  customerId    String  @map("customer_id") @db.Uuid
  label         String? @db.VarChar(50)
  recipientName String  @map("recipient_name") @db.VarChar(150)
  phone         String  @db.VarChar(30)
  addressLine   String  @map("address_line")
  city          String  @db.VarChar(100)
  region        String? @db.VarChar(100)
  postalCode    String? @map("postal_code") @db.VarChar(30)
  isDefault     Boolean @default(false) @map("is_default")

  customer       Customer @relation(fields: [customerId], references: [id], onDelete: Cascade)
  shippedOrders  Order[]

  @@index([customerId])
  @@map("addresses")
}

// ------------------------------------------------------------------ catalogue

model Category {
  id          String   @id @default(uuid()) @db.Uuid
  /// Self-referencing category tree. SetNull, not Cascade: removing a parent
  /// promotes its children rather than deleting a whole branch.
  parentId    String?  @map("parent_id") @db.Uuid
  name        String   @db.VarChar(150)
  slug        String   @unique @db.VarChar(180)
  description String?
  isActive    Boolean  @default(true) @map("is_active")
  createdAt   DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt   DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  parent   Category?  @relation("CategoryTree", fields: [parentId], references: [id], onDelete: SetNull)
  children Category[] @relation("CategoryTree")
  products Product[]

  @@index([parentId])
  @@map("categories")
}

model Product {
  id             String        @id @default(uuid()) @db.Uuid
  categoryId     String?       @map("category_id") @db.Uuid
  name           String        @db.VarChar(220)
  slug           String        @unique @db.VarChar(220)
  description    String?
  status         ProductStatus @default(DRAFT)
  basePrice      Decimal       @map("base_price") @db.Decimal(12, 2)
  compareAtPrice Decimal?      @map("compare_at_price") @db.Decimal(12, 2)
  /// Free-form product attributes, and where images and tags live: the ERD
  /// models no separate table for either.
  attributes     Json?
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  category Category?        @relation(fields: [categoryId], references: [id], onDelete: SetNull)
  variants ProductVariant[]
  reviews  Review[]

  @@index([categoryId])
  @@index([status])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(uuid()) @db.Uuid
  productId      String   @map("product_id") @db.Uuid
  sku            String   @unique @db.VarChar(100)
  price          Decimal  @db.Decimal(12, 2)
  compareAtPrice Decimal? @map("compare_at_price") @db.Decimal(12, 2)
  attributes     Json?
  isActive       Boolean  @default(true) @map("is_active")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  inventory  Inventory?
  cartItems  CartItem[]
  orderItems OrderItem[]

  @@index([productId])
  @@map("product_variants")
}

model Inventory {
  id               String   @id @default(uuid()) @db.Uuid
  productVariantId String   @unique @map("product_variant_id") @db.Uuid
  quantity         Int      @default(0)
  reservedQuantity Int      @default(0) @map("reserved_quantity")
  reorderLevel     Int?     @map("reorder_level")
  updatedAt        DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Cascade)

  @@map("inventory")
}

// --------------------------------------------------------- carts and orders

model Cart {
  id         String     @id @default(uuid()) @db.Uuid
  /// Nullable: someone browsing on WhatsApp has no customer record yet.
  customerId String?    @map("customer_id") @db.Uuid
  sessionKey String?    @unique @map("session_key") @db.VarChar(190)
  status     CartStatus @default(OPEN)
  createdAt  DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt  DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer Customer?  @relation(fields: [customerId], references: [id], onDelete: SetNull)
  items    CartItem[]

  @@index([customerId])
  @@map("carts")
}

model CartItem {
  id                 String   @id @default(uuid()) @db.Uuid
  cartId             String   @map("cart_id") @db.Uuid
  productVariantId   String   @map("product_variant_id") @db.Uuid
  quantity           Int
  /// Frozen at add-to-cart so a price change mid-session cannot move the
  /// total under the customer.
  unitPriceSnapshot  Decimal  @map("unit_price_snapshot") @db.Decimal(12, 2)
  createdAt          DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  cart    Cart           @relation(fields: [cartId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)

  @@index([cartId])
  @@map("cart_items")
}

model Order {
  id                String      @id @default(uuid()) @db.Uuid
  customerId        String?     @map("customer_id") @db.Uuid
  shippingAddressId String?     @map("shipping_address_id") @db.Uuid
  orderNumber       String      @unique @map("order_number") @db.VarChar(80)
  status            OrderStatus @default(PENDING)
  subtotal          Decimal     @db.Decimal(12, 2)
  discount          Decimal     @default(0) @db.Decimal(12, 2)
  shippingFee       Decimal     @default(0) @map("shipping_fee") @db.Decimal(12, 2)
  tax               Decimal     @default(0) @db.Decimal(12, 2)
  total             Decimal     @db.Decimal(12, 2)
  /// Not on the ERD: `orders` is drawn with no timestamp at all, which leaves
  /// the order list with no arrival order and the dashboard no way to say
  /// "recent". Same decision, and the same reason, as D-34 on the master side.
  placedAt          DateTime    @default(now()) @map("placed_at") @db.Timestamptz(3)
  updatedAt         DateTime    @updatedAt @map("updated_at") @db.Timestamptz(3)

  customer        Customer?      @relation(fields: [customerId], references: [id], onDelete: SetNull)
  shippingAddress Address?       @relation(fields: [shippingAddressId], references: [id], onDelete: SetNull)
  items           OrderItem[]
  payments        OrderPayment[]

  @@index([customerId])
  @@index([status])
  @@index([placedAt])
  @@map("orders")
}

model OrderItem {
  id                  String  @id @default(uuid()) @db.Uuid
  orderId             String  @map("order_id") @db.Uuid
  productVariantId    String  @map("product_variant_id") @db.Uuid
  /// Snapshots keep the line readable after a rename, and are why the variant
  /// relation can be Restrict without blocking catalogue tidy-ups forever.
  productNameSnapshot String  @map("product_name_snapshot") @db.VarChar(220)
  skuSnapshot         String  @map("sku_snapshot") @db.VarChar(100)
  unitPrice           Decimal @map("unit_price") @db.Decimal(12, 2)
  quantity            Int
  total               Decimal @db.Decimal(12, 2)

  order   Order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  variant ProductVariant @relation(fields: [productVariantId], references: [id], onDelete: Restrict)
  reviews Review[]

  @@index([orderId])
  @@index([productVariantId])
  @@map("order_items")
}

model OrderPayment {
  id                String        @id @default(uuid()) @db.Uuid
  orderId           String        @map("order_id") @db.Uuid
  provider          String        @db.VarChar(80)
  providerReference String?       @map("provider_reference") @db.VarChar(190)
  amount            Decimal       @db.Decimal(12, 2)
  currency          String        @db.VarChar(10)
  status            PaymentStatus @default(PENDING)
  paidAt            DateTime?     @map("paid_at") @db.Timestamptz(3)
  createdAt         DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("order_payments")
}

model Review {
  id          String       @id @default(uuid()) @db.Uuid
  customerId  String       @map("customer_id") @db.Uuid
  productId   String       @map("product_id") @db.Uuid
  /// Nullable: a review may exist with no verified purchase behind it.
  orderItemId String?      @map("order_item_id") @db.Uuid
  rating      Int          @db.SmallInt
  comment     String?
  status      ReviewStatus @default(PENDING)
  createdAt   DateTime     @default(now()) @map("created_at") @db.Timestamptz(3)

  customer  Customer   @relation(fields: [customerId], references: [id], onDelete: Cascade)
  product   Product    @relation(fields: [productId], references: [id], onDelete: Cascade)
  orderItem OrderItem? @relation(fields: [orderItemId], references: [id], onDelete: SetNull)

  @@index([productId])
  @@index([status])
  @@map("reviews")
}

// ------------------------------------------------------- whatsapp messaging

model WhatsappAccount {
  id                   String                     @id @default(uuid()) @db.Uuid
  phoneNumberId        String                     @unique @map("phone_number_id") @db.VarChar(150)
  businessAccountId    String                     @map("business_account_id") @db.VarChar(150)
  displayPhoneNumber   String                     @map("display_phone_number") @db.VarChar(40)
  /// A pointer into the secret manager, never the token itself (S-03).
  accessTokenReference String                     @map("access_token_reference")
  status               WhatsappAccountStatus      @default(DISCONNECTED)
  verificationStatus   WhatsappVerificationStatus @default(PENDING) @map("verification_status")
  qualityRating        String?                    @map("quality_rating") @db.VarChar(30)
  lastWebhookAt        DateTime?                  @map("last_webhook_at") @db.Timestamptz(3)
  createdAt            DateTime                   @default(now()) @map("created_at") @db.Timestamptz(3)

  contacts      Contact[]
  webhookEvents WebhookEvent[]

  @@map("whatsapp_accounts")
}

model Contact {
  id                 String        @id @default(uuid()) @db.Uuid
  whatsappAccountId  String?       @map("whatsapp_account_id") @db.Uuid
  /// Nullable: someone can message before they are ever a customer.
  customerId         String?       @map("customer_id") @db.Uuid
  customerName       String?       @map("customer_name") @db.VarChar(150)
  phoneNumber        String        @map("phone_number") @db.VarChar(40)
  displayPhoneNumber String?       @map("display_phone_number") @db.VarChar(40)
  status             ContactStatus @default(ACTIVE)
  createdAt          DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt          DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  whatsappAccount WhatsappAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)
  customer        Customer?        @relation(fields: [customerId], references: [id], onDelete: SetNull)
  conversations   Conversation[]

  @@index([phoneNumber])
  @@index([customerId])
  @@map("contacts")
}

model Conversation {
  id             String             @id @default(uuid()) @db.Uuid
  contactId      String             @map("contact_id") @db.Uuid
  /// Nullable: unassigned until a human picks it up; the AI needs no row.
  assignedUserId String?            @map("assigned_user_id") @db.Uuid
  status         ConversationStatus @default(OPEN)
  lastMessageAt  DateTime?          @map("last_message_at") @db.Timestamptz(3)
  createdAt      DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime           @updatedAt @map("updated_at") @db.Timestamptz(3)

  contact      Contact      @relation(fields: [contactId], references: [id], onDelete: Cascade)
  assignedUser User?        @relation(fields: [assignedUserId], references: [id], onDelete: SetNull)
  messages     Message[]
  aiUsageLogs  AiUsageLog[]

  @@index([contactId])
  @@index([status, lastMessageAt])
  @@map("conversations")
}

model Message {
  id                String            @id @default(uuid()) @db.Uuid
  conversationId    String            @map("conversation_id") @db.Uuid
  direction         MessageDirection
  senderType        MessageSenderType @map("sender_type")
  content           String?
  messageType       MessageType       @default(TEXT) @map("message_type")
  providerMessageId String?           @map("provider_message_id") @db.VarChar(190)
  replyToMessageId  String?           @map("reply_to_message_id") @db.Uuid
  status            MessageStatus     @default(QUEUED)
  createdAt         DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  replyTo      Message?     @relation("MessageReplies", fields: [replyToMessageId], references: [id], onDelete: SetNull)
  replies      Message[]    @relation("MessageReplies")

  @@index([conversationId, createdAt])
  @@index([providerMessageId])
  @@map("messages")
}

model WebhookEvent {
  id                String             @id @default(uuid()) @db.Uuid
  whatsappAccountId String?            @map("whatsapp_account_id") @db.Uuid
  /// Unique: the provider retries, and a retry must not be processed twice.
  providerEventId   String?            @unique @map("provider_event_id") @db.VarChar(190)
  eventType         String             @map("event_type") @db.VarChar(100)
  payload           Json
  processedAt       DateTime?          @map("processed_at") @db.Timestamptz(3)
  status            WebhookEventStatus @default(RECEIVED)
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(3)

  whatsappAccount WhatsappAccount? @relation(fields: [whatsappAccountId], references: [id], onDelete: SetNull)

  @@index([status, createdAt])
  @@map("webhook_events")
}

// -------------------------------------------------------------- AI and store

/// `providerId` and `modelId` reference the master database's `ai_providers`
/// and `ai_models`. Postgres cannot express a cross-database foreign key, so
/// they are bare UUIDs here.
model TenantAiConfiguration {
  id              String   @id @default(uuid()) @db.Uuid
  providerId      String   @map("provider_id") @db.Uuid
  modelId         String   @map("model_id") @db.Uuid
  /// A pointer into the secret manager, never a key (S-03).
  secretReference String?  @map("secret_reference")
  isActive        Boolean  @default(true) @map("is_active")
  promptReference String?  @map("prompt_reference") @db.VarChar(190)
  tokenLimit      BigInt?  @map("token_limit")
  createdAt       DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("tenant_ai_configurations")
}

model AiUsageLog {
  id             String        @id @default(uuid()) @db.Uuid
  conversationId String?       @map("conversation_id") @db.Uuid
  providerId     String?       @map("provider_id") @db.Uuid
  modelId        String?       @map("model_id") @db.Uuid
  requestType    String        @map("request_type") @db.VarChar(80)
  inputTokens    BigInt        @default(0) @map("input_tokens")
  outputTokens   BigInt        @default(0) @map("output_tokens")
  totalTokens    BigInt        @default(0) @map("total_tokens")
  estimatedCost  Decimal?      @map("estimated_cost") @db.Decimal(12, 6)
  status         AiUsageStatus @default(SUCCESS)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  conversation Conversation? @relation(fields: [conversationId], references: [id], onDelete: SetNull)

  @@index([createdAt])
  @@index([conversationId])
  @@map("ai_usage_logs")
}

model StoreSetting {
  id         String   @id @default(uuid()) @db.Uuid
  settingKey String   @unique @map("setting_key") @db.VarChar(120)
  value      Json
  updatedAt  DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  @@map("store_settings")
}
