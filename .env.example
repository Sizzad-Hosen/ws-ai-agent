# Master PostgreSQL database. Never point this at a tenant database.
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/wa_agent_master

# Public canonical URL used when absolute application URLs are required.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# Used only by `npm run db:seed`. Choose unique values outside development.
BO_SEED_ADMIN_EMAIL=admin@example.com
BO_SEED_ADMIN_PASSWORD=replace-with-a-strong-development-password


# Root domain for host-based tenant routing, e.g. acme.example.com -> "acme".
# Leave empty to disable it. Note that tenant sites are served from the
# application root (localhost:3000/acme) and nothing here maps a host back to
# that route, so this affects host parsing only — the recorded site URL is the
# path form whenever NEXT_PUBLIC_APP_URL is set.
TENANT_ROOT_DOMAIN=

# Connection template for per-tenant databases. {{host}}, {{port}}, {{database}},
# {{username}} and {{password}} are substituted from tenant_databases plus the
# resolved secret. Only used by the local secret provider below.
TENANT_DATABASE_URL_TEMPLATE=

# Local development only. JSON object mapping a tenant_databases.secret_reference
# to its password, standing in for a real secret manager. Never set in production.
TENANT_DB_SECRETS_JSON=

# Administrator connection used to CREATE DATABASE for a newly approved tenant
# and apply src/server/tenancy/schema/. Falls back to DATABASE_URL, which is
# what makes local provisioning work with no extra setup. In production this
# should be a dedicated account that can create databases and little else.
TENANT_PROVISIONER_DATABASE_URL=

# Where uploaded profile pictures are written, and the URL prefix they are
# served under. The defaults below put them inside public/ so Next serves them
# directly. This is local-disk storage: files do not survive a container
# rebuild and are not shared between instances, which suits a single server.
AVATAR_UPLOAD_DIR=public/uploads/avatars
AVATAR_URL_BASE=/uploads/avatars

# Outgoing mail. An empty SMTP_HOST disables sending: messages are rendered and
# logged but never delivered, which is what CI wants and what a fresh checkout
# gets. For local work, point this at a mail catcher — it accepts every message
# and delivers none of them, so no real person is ever emailed while testing.
#
#   Papercut SMTP   winget install ChangemakerStudios.Papercut-SMTP   port 25
#   Mailpit         docker run -p 1025:1025 -p 8025:8025 axllent/mailpit
#   MailHog         docker run -p 1025:1025 -p 8025:8025 mailhog/mailhog
#
# Papercut shows what it caught in its own window; Mailpit and MailHog at
# http://localhost:8025.
SMTP_HOST=
SMTP_PORT=25
SMTP_SECURE=false
SMTP_USER=
SMTP_PASSWORD=
EMAIL_FROM=Ordivex <no-reply@ordivex.local>

# Where the back office is told about a new application. A shared review inbox
# rather than a person, so nothing is missed while someone is on leave.
EMAIL_REVIEW_INBOX=registrations@ordivex.local
